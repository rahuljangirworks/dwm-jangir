+        c.save ();
+        c.set_source_rgba (0.035, 0.055, 0.075, 0.10);
+        c.rectangle (0, 0, width, height);
+        c.fill ();
+        c.set_source (grain_pattern);
+        c.rectangle (0, 0, width, height);
+        c.fill ();
+        c.restore ();
+    }
