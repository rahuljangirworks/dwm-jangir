+        var height = get_allocated_height ();
+        if (width < 20 || height < 20 || sunrise_minutes < 0 || sunset_minutes <= sunrise_minutes)
+            return false;
+
+        var left = 0.0;
+        var right = (double) width;
+        var baseline = height * 0.90;
+        var peak = height * 0.18;
+        /* Leave room below the low point for a complete moonlight bloom. */
+        var night_floor = height - 42.0;
+        var noon_x = (left + right) / 2.0;
+
+        var raw_progress = (current_minutes - sunrise_minutes) /
+            (sunset_minutes - sunrise_minutes);
