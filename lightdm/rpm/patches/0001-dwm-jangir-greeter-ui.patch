+    private double cubic_bezier (double p0, double p1, double p2,
+                                 double p3, double t)
+    {
+        var inverse = 1.0 - t;
+        return inverse * inverse * inverse * p0 +
+            3.0 * inverse * inverse * t * p1 +
+            3.0 * inverse * t * t * p2 + t * t * t * p3;
+    }
+
+    /* Match the exact two-part Cairo path below.  Every moving body and the
+     * animation dash use this one calculation, so neither can drift away
+     * from the visible line. */
+    private void get_path_point (bool daytime, double progress,
+                                 double width, double baseline, double peak,
+                                 double night_floor,
+                                 out double x, out double y)
+    {
+        progress = Math.fmax (0.0, Math.fmin (1.0, progress));
+        var t = progress <= 0.5 ? progress * 2.0 : (progress - 0.5) * 2.0;
+        if (progress <= 0.5)
+        {
+            x = cubic_bezier (0.0, width * 0.20, width * 0.32,
+                              width * 0.50, t);
+            y = daytime
+                ? cubic_bezier (baseline, baseline - 18, peak, peak, t)
+                : cubic_bezier (peak + 16, peak + 38, night_floor,
+                                night_floor, t);
+        }
+        else
+        {
+            x = cubic_bezier (width * 0.50, width * 0.68, width * 0.80,
+                              width, t);
+            y = daytime
+                ? cubic_bezier (peak, peak, baseline - 18, baseline, t)
+                : cubic_bezier (night_floor, night_floor, peak + 38,
+                                peak + 16, t);
+        }
+    }
