+public class SolarTimeline : Gtk.DrawingArea
+{
+    private int sunrise_minutes = -1;
+    private int sunset_minutes = -1;
+    private double current_minutes = -1;
+
+    public SolarTimeline ()
+    {
+        set_size_request (640, 130);
+        halign = Gtk.Align.FILL;
+        hexpand = true;
+        can_focus = false;
+        /* A tiny Cairo-only pulse makes the path feel alive without another
+         * widget, image, or network request. */
+        /* Six frames per second is smooth enough for the small travelling
+         * dash, and avoids repainting the full transparent greeter at 25 FPS. */
+        Timeout.add (160, () => {
