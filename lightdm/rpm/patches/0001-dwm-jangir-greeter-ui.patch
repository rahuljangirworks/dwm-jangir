+    private bool update_greeter_clock ()
+    {
+        var current_time = new DateTime.now_local ();
+        var clock_format = UGSettings.get_string (UGSettings.KEY_CLOCK_FORMAT);
+        greeter_date.set_label (current_time.format ("%A, %d %B %Y"));
+        greeter_clock.set_label (current_time.format (clock_format));
+        update_greeter_local_status (current_time);
+        if (solar_sunrise_minutes >= 0 && solar_sunset_minutes > solar_sunrise_minutes)
+        {
+            var minutes = current_time.get_hour () * 60 + current_time.get_minute ();
+            var precise_minutes = minutes + current_time.get_second () / 60.0;
+            update_solar_next_event (minutes);
+            solar_timeline.set_current_time (precise_minutes);
+        }
+        return true;
+    }
+
+    private string format_local_offset (DateTime current_time)
+    {
+        var offset = current_time.format ("%z");
+        if (offset.length == 5)
+        {
+            var sign = offset.substring (0, 1);
+            var hour = int.parse (offset.substring (1, 2));
+            return "GMT%s%d:%s".printf (sign, hour, offset.substring (3, 2));
+        }
+        return current_time.format ("%Z");
+    }
+
+    private void update_greeter_local_status (DateTime current_time)
+    {
+        var local_time = current_time.format ("%I:%M %p");
+        var status = "Local time: %s %s".printf (local_time,
+            format_local_offset (current_time));
+        if (weather_location != "")
+            status = "%s • %s".printf (weather_location, status);
+        greeter_local_status.set_label (status);
+    }
+
+    private void update_solar_next_event (int current_minutes)
+    {
+        var is_daytime = current_minutes >= solar_sunrise_minutes &&
+            current_minutes < solar_sunset_minutes;
+        /* Retain each grid column even while the other event is invisible,
+         * so sunrise stays at the left and sunset stays at the right. */
+        solar_sunrise_event.opacity = is_daytime ? 0.0 : 1.0;
+        solar_sunset_event.opacity = is_daytime ? 1.0 : 0.0;
+    }
+
+    private SolarWeatherData? parse_weather_response (string response)
+    {
+        var fields = response.strip ().split ("|");
+        if (fields.length < 5)
+            return null;
+
+        var location = fields[0].strip ();
+        var temperature = fields[1].strip ();
+        var condition = fields[2].strip ();
+        var sunrise = fields[3].strip ();
+        var sunset = fields[4].strip ();
+        if (location == "" || temperature == "" || condition == "" ||
+            sunrise == "" || sunset == "")
+            return null;
+
+        return new SolarWeatherData (location, temperature, condition, sunrise, sunset);
+    }
+
+    private int solar_minutes (string value)
+    {
+        var parts = value.strip ().split (":");
+        if (parts.length < 2)
+            return -1;
+
+        try
+        {
+            var hour = int.parse (parts[0]);
+            var minute = int.parse (parts[1]);
+            if (hour < 0 || hour > 23 || minute < 0 || minute > 59)
+                return -1;
+            return hour * 60 + minute;
+        }
+        catch (Error e)
+        {
+            return -1;
+        }
+    }
+
+    private string format_solar_time (string value)
+    {
+        var minutes = solar_minutes (value);
+        if (minutes < 0)
+            return value;
+
+        var hour = minutes / 60;
+        var minute = minutes % 60;
+        var suffix = hour >= 12 ? "PM" : "AM";
+        var display_hour = hour % 12;
+        if (display_hour == 0)
+            display_hour = 12;
+        return "%d:%02d %s".printf (display_hour, minute, suffix);
+    }
+
+    private void refresh_weather ()
+    {
+        if (weather_fetch_active)
+            return;
+
+        weather_fetch_active = true;
+        try
+        {
+            new Thread<void*>.try ("dwm-weather", () => {
+                string response = "";
+                int exit_status = 1;
+                try
+                {
+                    string[] argv = {
+                        "curl",
+                        "--fail",
+                        "--silent",
+                        "--show-error",
+                        "--connect-timeout", "2",
+                        "--max-time", "4",
+                        "--retry", "0",
+                        "--user-agent", "dwm-jangir-lightdm/1.0",
+                        "https://wttr.in/?format=%l%7C%t%7C%C%7C%S%7C%s"
+                    };
+                    Process.spawn_sync (null, argv, null, SpawnFlags.SEARCH_PATH,
+                        null, out response, null, out exit_status);
+                }
+                catch (Error e)
+                {
+                    debug ("Weather request failed: %s", e.message);
+                }
+
+                var weather_data = exit_status == 0
+                    ? parse_weather_response (response)
+                    : null;
+                Idle.add (() => {
+                    weather_fetch_active = false;
+                    if (weather_data != null)
+                    {
+                        var sunrise = solar_minutes (weather_data.sunrise);
+                        var sunset = solar_minutes (weather_data.sunset);
+                        if (sunrise >= 0 && sunset > sunrise)
+                        {
+                            var now = new DateTime.now_local ();
+                            weather_location = weather_data.location;
+                            update_greeter_local_status (now);
+                            solar_sunrise_minutes = sunrise;
+                            solar_sunset_minutes = sunset;
+                            solar_sunrise_text = format_solar_time (weather_data.sunrise);
+                            solar_sunset_text = format_solar_time (weather_data.sunset);
+                            solar_sunrise_time.set_label (solar_sunrise_text);
+                            solar_sunset_time.set_label (solar_sunset_text);
+                            update_solar_next_event (
+                                now.get_hour () * 60 + now.get_minute ());
+                            solar_timeline.set_times (sunrise, sunset,
+                                now.get_hour () * 60 + now.get_minute ());
+                            solar_box.visible = true;
+                        }
+                    }
+                    return false;
+                });
+                return null;
+            });
+        }
+        catch (Error e)
+        {
+            weather_fetch_active = false;
+            debug ("Unable to start weather request: %s", e.message);
+        }
+    }
