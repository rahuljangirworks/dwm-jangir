+    private void show_power_popup (Gtk.MenuItem trigger, Gtk.Box popup_box)
+    {
+        if (power_popup == null)
+            return;
+
+        trigger.get_style_context ().add_class ("open");
+        power_popup.show_all ();
+        Gtk.Allocation allocation;
+        trigger.get_allocation (out allocation);
+        int trigger_x, trigger_y;
+        trigger.translate_coordinates (main_window, 0, 0, out trigger_x, out trigger_y);
+        int width, height;
+        power_popup.get_size (out width, out height);
+        if (width < 1)
+            width = 190;
+        Gdk.Rectangle monitor;
+        trigger.get_screen ().get_monitor_geometry (
+            trigger.get_screen ().get_monitor_at_window (trigger.get_window ()), out monitor);
+        /* The top-bar trigger has a 16px right margin.  Account for that
+         * margin so the popup's right edge aligns with the visible 32px
+         * trigger instead of the menubar's outer allocation. */
+        int x = trigger_x + allocation.width - width - 16;
+        int y = trigger_y + allocation.height + 6;
+        x = int.max (monitor.x + 16, int.min (x, monitor.x + monitor.width - width - 16));
+        y = int.max (monitor.y + 16, int.min (y, monitor.y + monitor.height - height - 16));
+        power_popup.move (x, y);
+        shape_power_popup ();
+        power_popup.present ();
+        power_popup.grab_focus ();
+        Gtk.grab_add (power_popup);
+        /* Do not preselect the first action; keyboard focus is restored by
+         * normal Tab/arrow navigation and pointer hover remains visible. */
+        power_popup.set_focus (null);
+    }
+
+    private void shape_power_popup ()
+    {
+        if (power_popup == null || !power_popup.get_realized ())
+            return;
+
+        int width, height;
+        power_popup.get_size (out width, out height);
+        int radius = int.min (10, int.min (width, height) / 2);
+        if (width <= 0 || height <= 0 || radius <= 0)
+            return;
+
+        var region = new Cairo.Region ();
+        var body = Cairo.RectangleInt () { x = radius, y = 0,
+                                           width = width - radius * 2,
+                                           height = height };
+        region.union (new Cairo.Region.rectangle (body));
+        body = Cairo.RectangleInt () { x = 0, y = radius,
+                                       width = width, height = height - radius * 2 };
+        region.union (new Cairo.Region.rectangle (body));
+        for (int y = 0; y < radius; y++)
+        {
+            int inset = radius - (int) Math.sqrt (radius * radius -
+                                                   (radius - y - 1) * (radius - y - 1));
+            var top = Cairo.RectangleInt () { x = inset, y = y,
+                                              width = width - inset * 2, height = 1 };
+            var bottom = Cairo.RectangleInt () { x = inset, y = height - y - 1,
+                                                 width = width - inset * 2, height = 1 };
+            region.union (new Cairo.Region.rectangle (top));
+            region.union (new Cairo.Region.rectangle (bottom));
+        }
+        power_popup.shape_combine_region (region);
+        var window = power_popup.get_window ();
+        if (window != null)
+            window.shape_combine_region (region, 0, 0);
+    }
