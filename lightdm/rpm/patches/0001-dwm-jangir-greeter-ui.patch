  *          Michael Terry <michael.terry@canonical.com>
  */

+public class LoginMark : Gtk.DrawingArea
+{
+    public bool is_user { get; construct; }
+
+    public LoginMark (bool is_user)
+    {
+        Object (is_user: is_user);
+    }
+
+    construct
+    {
+        set_size_request (20, 20);
+        get_accessible ().set_name (is_user ? _("User") : _("dwm-jangir"));
+    }
+
+    public override bool draw (Cairo.Context c)
+    {
+        var width = get_allocated_width ();
+        var height = get_allocated_height ();
+        var cx = width / 2.0;
+        var cy = height / 2.0;
+
+        c.save ();
+        c.set_source_rgba (0.55, 0.59, 0.64, 0.95);
+        c.set_line_width (1.4);
+
+        if (is_user)
+        {
+            c.arc (cx, cy - 4.0, 3.0, 0, 2 * Math.PI);
+            c.stroke ();
+            c.arc (cx, cy + 7.0, 5.5, Math.PI, 2 * Math.PI);
+            c.stroke ();
+        }
+        else
+        {
+            // A tiny tiling-window mark for dwm-jangir.
+            c.rectangle (cx - 7.0, cy - 6.0, 8.0, 12.0);
+            c.rectangle (cx + 3.0, cy - 6.0, 4.0, 5.0);
+            c.rectangle (cx + 3.0, cy + 1.0, 4.0, 5.0);
+            c.stroke ();
+        }
+
+        c.restore ();
+        return false;
+    }
+}
