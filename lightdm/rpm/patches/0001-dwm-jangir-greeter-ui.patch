+/* A small Cairo-drawn power mark.  The previous SVG was only 16px and can
+ * be reduced or rendered indistinctly by some greeter themes.  Drawing it
+ * here keeps the control crisp and independent of the host icon theme. */
+private class PowerMark : Gtk.DrawingArea
+{
+    construct
+    {
+        set_size_request (24, 24);
+    }
+
+    public override bool draw (Cairo.Context cr)
+    {
+        var width = get_allocated_width ();
+        var height = get_allocated_height ();
+        var center_x = width / 2.0;
+        var center_y = height / 2.0;
+        var radius = double.min (width, height) / 2.0 - 4.0;
+
+        cr.set_source_rgba (0.78, 0.83, 0.89, 1.0);
+        cr.set_line_width (2.0);
+        cr.set_line_cap (Cairo.LineCap.ROUND);
+        /* Draw the long lower arc, leaving a deliberate opening at the top. */
+        cr.arc (center_x, center_y, radius, 5.50, 10.20);
+        cr.stroke ();
+        cr.move_to (center_x, center_y - radius - 1.0);
+        cr.line_to (center_x, center_y);
+        cr.stroke ();
+
+        return false;
+    }
+}
