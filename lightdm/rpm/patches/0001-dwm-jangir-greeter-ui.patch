+                diagonal_fade.add_color_stop_rgba (0.75, 0.37, 0.61, 1.0, 0.0);
+                diagonal_fade.add_color_stop_rgba (1.0, 0.37, 0.61, 1.0, 0.0);
+            }
+            else
+            {
+                diagonal_fade.add_color_stop_rgba (0.0, 0.37, 0.61, 1.0, 0.0);
+                diagonal_fade.add_color_stop_rgba (0.25, 0.37, 0.61, 1.0, 0.0);
+                diagonal_fade.add_color_stop_rgba (1.0, 0.37, 0.61, 1.0, 0.50);
