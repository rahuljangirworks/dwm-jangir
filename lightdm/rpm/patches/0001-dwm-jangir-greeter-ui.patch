+            daylight.add_color_stop_rgba (0.0, 0.36, 0.22, 0.09, 0.10);
+            daylight.add_color_stop_rgba (0.36, 0.83, 0.52, 0.21, 0.88);
+            daylight.add_color_stop_rgba (0.50, 1.0, 0.72, 0.34, 1.0);
+            daylight.add_color_stop_rgba (0.64, 0.83, 0.52, 0.21, 0.88);
+            daylight.add_color_stop_rgba (1.0, 0.36, 0.22, 0.09, 0.10);
+            c.set_source (daylight);
+            c.move_to (left, baseline);
+            c.curve_to (width * 0.20, baseline - 18,
+                        width * 0.32, peak,
+                        noon_x, peak);
+            c.curve_to (width * 0.68, peak,
+                        width * 0.80, baseline - 18,
+                        right, baseline);
+            c.stroke ();
+        }
