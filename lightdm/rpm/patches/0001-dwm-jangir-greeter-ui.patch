+            var moon_path = new Cairo.Pattern.linear (left, 0, right, 0);
+            moon_path.add_color_stop_rgba (0.0, 0.20, 0.28, 0.56, 0.20);
+            moon_path.add_color_stop_rgba (0.50, 0.56, 0.62, 1.0, 0.92);
+            moon_path.add_color_stop_rgba (1.0, 0.20, 0.28, 0.56, 0.20);
+            c.set_source (moon_path);
+            c.move_to (left, peak + 16);
+            c.curve_to (width * 0.20, peak + 38,
+                        width * 0.32, night_floor,
+                        noon_x, night_floor);
+            c.curve_to (width * 0.68, night_floor,
+                        width * 0.80, peak + 38,
+                        right, peak + 16);
+            c.stroke ();
+
+            double moon_x, moon_y;
+            get_path_point (false, 1.0 - night_progress, width, baseline,
