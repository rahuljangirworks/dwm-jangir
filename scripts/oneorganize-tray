#!/usr/bin/env python3
"""
OneOrganize Native System Tray Widget for DWM / Quickshell
---------------------------------------------------------
Natively integrates with Quickshell's SystemTray (StatusNotifierItem) via AppIndicator3:
- Appears directly inside the top panel's tray area.
- Icon dynamically indicates state:
    * Green Clock: Clocked In
    * Coral/Amber Clock: Not Clocked In / Clocked Out
- Clicking the tray icon drops down the menu directly below the tray in the top panel.
- Menu includes:
    * Live Clock-In time & live worked timer (e.g. 03:52:10)
    * Quick Clock-In (disabled if already clocked in)
    * Quick Clock-Out for SDV Platform (opens task prompt with default)
    * Open Portal in Google Chrome
    * Refresh Status
    * Quit
"""

import os
import sys
import re
import json
import time
import threading
import subprocess
import urllib.request
import urllib.parse
import urllib.error
import http.cookiejar
from datetime import datetime, timedelta
from pathlib import Path

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('AppIndicator3', '0.1')
from gi.repository import Gtk, AppIndicator3, GLib

# Configuration
DEFAULT_BASE_URL = os.environ.get("ONEORG_URL", "http://192.168.0.143/oneorganize")
DEFAULT_EMAIL = os.environ.get("ONEORG_EMAIL", "rahul.jangir@getmysolutions.in")
DEFAULT_PASSWORD = os.environ.get("ONEORG_PASSWORD", "Rahul@1998")
DEFAULT_PROJECT_ID = "2"
DEFAULT_PROJECT_NAME = "SDV Platform"
DEFAULT_TASK = "Completed scheduled development tasks, code review, bug fixes, and daily progress reporting."

COOKIE_DIR = Path.home() / ".cache" / "oneorganize"
COOKIE_FILE = COOKIE_DIR / "cookies.txt"
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# Assets
ASSET_DIR = Path.home() / ".local/share/dwm-jangir/config/quickshell/assets"
if not ASSET_DIR.exists():
    ASSET_DIR = Path("/home/rahul/work/dwm-jangir/config/quickshell/assets")

ICON_CLOCKIN = str(ASSET_DIR / "oneorganize-clockin.svg")
ICON_CLOCKOUT = str(ASSET_DIR / "oneorganize-clockout.svg")


class OneOrganizeTray:
    def __init__(self):
        self.is_clocked_in = False
        self.is_clocked_out = False
        self.clock_in_time_text = ""
        self.clock_out_time_text = ""
        self.clock_in_raw = None
        self.clock_out_raw = None
        self.employee_name = "Mr. Rahul Jangir"
        self.clock_in_dt = None
        self.current_data = {}

        # Setup persistent cookie jar
        COOKIE_DIR.mkdir(parents=True, exist_ok=True)
        self.cookie_jar = http.cookiejar.MozillaCookieJar(str(COOKIE_FILE))
        if COOKIE_FILE.exists():
            try:
                self.cookie_jar.load(ignore_discard=True, ignore_expires=True)
            except Exception:
                pass

        self.opener = urllib.request.build_opener(
            urllib.request.HTTPCookieProcessor(self.cookie_jar)
        )

        # Setup AppIndicator3 (natively integrates with Quickshell StatusNotifierWatcher)
        initial_icon = ICON_CLOCKIN if os.path.exists(ICON_CLOCKIN) else "appointment-soon"
        self.indicator = AppIndicator3.Indicator.new(
            "oneorganize",
            initial_icon,
            AppIndicator3.IndicatorCategory.APPLICATION_STATUS
        )
        self.indicator.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
        self.indicator.set_title("OneOrganize HRM")

        # Build Menu
        self.build_menu()

        # Initial background fetch
        self.async_refresh()

        # Timers:
        # 1. Update live worked time every 1 second
        GLib.timeout_add_seconds(1, self.tick_live_timer)
        # 2. Auto sync status with server every 60 seconds
        GLib.timeout_add_seconds(60, self.async_refresh_timer)

    def save_cookies(self):
        try:
            self.cookie_jar.save(ignore_discard=True, ignore_expires=True)
        except Exception:
            pass

    def request(self, url, data=None, headers=None, method=None, timeout=12):
        req_headers = {"User-Agent": USER_AGENT}
        if headers:
            req_headers.update(headers)
        req = urllib.request.Request(url, data=data, headers=req_headers, method=method)
        try:
            with self.opener.open(req, timeout=timeout) as resp:
                content = resp.read().decode('utf-8', errors='replace')
                return resp.geturl(), content, resp.getcode()
        except urllib.error.HTTPError as e:
            content = e.read().decode('utf-8', errors='replace')
            return e.geturl(), content, e.code

    def notify(self, title, message, icon="emblem-default", urgency="normal"):
        try:
            subprocess.run(
                ["notify-send", "-u", urgency, "-i", icon, title, message],
                check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
        except Exception:
            pass

    def build_menu(self):
        self.menu = Gtk.Menu()

        # 1. Header (Status)
        self.item_header = Gtk.MenuItem(label="● OneOrganize: Checking status...")
        self.item_header.set_sensitive(False)
        self.menu.append(self.item_header)

        # 2. Timer Label
        self.item_timer = Gtk.MenuItem(label="⏱ Worked Today: --:--:--")
        self.item_timer.set_sensitive(False)
        self.menu.append(self.item_timer)

        self.menu.append(Gtk.SeparatorMenuItem())

        # 3. Clock In Action
        self.item_clock_in = Gtk.MenuItem(label="▶ Clock In Now")
        self.item_clock_in.connect("activate", self.on_clock_in_clicked)
        self.menu.append(self.item_clock_in)

        # 4. Clock Out Action
        self.item_clock_out = Gtk.MenuItem(label="■ Clock Out (SDV Platform)...")
        self.item_clock_out.connect("activate", self.on_clock_out_clicked)
        self.menu.append(self.item_clock_out)

        self.menu.append(Gtk.SeparatorMenuItem())

        # 5. Open Web Portal
        self.item_portal = Gtk.MenuItem(label="🌐 Open Dashboard in Chrome")
        self.item_portal.connect("activate", self.on_open_portal_clicked)
        self.menu.append(self.item_portal)

        # 6. Refresh Status
        self.item_refresh = Gtk.MenuItem(label="🔄 Refresh Status")
        self.item_refresh.connect("activate", lambda w: self.async_refresh())
        self.menu.append(self.item_refresh)

        self.menu.append(Gtk.SeparatorMenuItem())

        # 7. Quit Tray
        self.item_quit = Gtk.MenuItem(label="✕ Quit Tray")
        self.item_quit.connect("activate", lambda w: Gtk.main_quit())
        self.menu.append(self.item_quit)

        self.menu.show_all()
        self.indicator.set_menu(self.menu)

    def login_if_needed(self):
        login_url = f"{DEFAULT_BASE_URL}/login"
        _, content, _ = self.request(login_url)
        token_match = re.search(r'name="_token"[^>]*value="([^"]+)"', content)
        if not token_match:
            token_match = re.search(r'value="([^"]+)"[^>]*name="_token"', content)
        if not token_match:
            raise RuntimeError("Cannot extract login CSRF token.")

        login_data = urllib.parse.urlencode({
            "_token": token_match.group(1),
            "email": DEFAULT_EMAIL,
            "password": DEFAULT_PASSWORD
        }).encode('utf-8')

        self.request(
            login_url, data=login_data, method="POST",
            headers={"Referer": login_url, "Content-Type": "application/x-www-form-urlencoded"}
        )
        self.save_cookies()

    def fetch_dashboard(self):
        dash_url = f"{DEFAULT_BASE_URL}/account-dashboard"
        final_url, html, _ = self.request(dash_url)
        if "login" in final_url.lower() or 'id="loginForm"' in html:
            self.login_if_needed()
            _, html, _ = self.request(dash_url)
            self.save_cookies()

        emp_match = re.search(r'Welcome\s+([^<\n\r]+)', html)
        emp_name = emp_match.group(1).strip() if emp_match else "Mr. Rahul Jangir"

        cin_match = re.search(r'Clock In At-\s*([^\s<]+(?:\s*[AP]M)?)', html, re.I)
        clock_in_text = cin_match.group(1).strip() if cin_match else None

        cout_match = re.search(r'Clock Out At-\s*([^\s<]+(?:\s*[AP]M)?)', html, re.I)
        clock_out_text = cout_match.group(1).strip() if cout_match else None

        clock_in_js = re.search(r'const\s+CLOCK_IN\s*=\s*"([^"]+)"', html)
        clock_in_raw = clock_in_js.group(1) if clock_in_js else None

        clock_out_js = re.search(r'const\s+CLOCK_OUT\s*=\s*"([^"]+)"', html)
        clock_out_raw = clock_out_js.group(1) if clock_out_js else None

        is_clocked_in = bool(clock_in_raw and clock_in_raw != "00:00:00")
        is_clocked_out = bool(clock_out_raw and clock_out_raw != "00:00:00")

        cin_form_token = None
        cin_tok = re.search(r'id="create_dash_att".*?name="_token"\s+value="([^"]+)"', html, re.DOTALL)
        if cin_tok:
            cin_form_token = cin_tok.group(1)

        cout_action = None
        cout_token = None
        form_match = re.search(r'<form\b([^>]*id="update_dash_att"[^>]*)>(.*?)</form>', html, re.DOTALL)
        if form_match:
            act = re.search(r'action="([^"]+)"', form_match.group(1))
            if act:
                cout_action = act.group(1)
            tok = re.search(r'name="_token"\s+type="hidden"\s+value="([^"]+)"', form_match.group(2))
            if not tok:
                tok = re.search(r'value="([^"]+)"[^>]*name="_token"', form_match.group(2))
            if tok:
                cout_token = tok.group(1)

        return {
            "employee": emp_name,
            "is_clocked_in": is_clocked_in,
            "is_clocked_out": is_clocked_out,
            "clock_in_text": clock_in_text or clock_in_raw or "",
            "clock_out_text": clock_out_text or clock_out_raw or "",
            "clock_in_raw": clock_in_raw,
            "clock_out_raw": clock_out_raw,
            "cin_form_token": cin_form_token,
            "cout_action": cout_action,
            "cout_token": cout_token
        }

    def async_refresh_timer(self):
        self.async_refresh()
        return True

    def async_refresh(self):
        def worker():
            try:
                data = self.fetch_dashboard()
                GLib.idle_add(self.apply_status_update, data)
            except Exception as e:
                pass
        threading.Thread(target=worker, daemon=True).start()

    def apply_status_update(self, data):
        self.current_data = data
        self.is_clocked_in = data.get("is_clocked_in", False)
        self.is_clocked_out = data.get("is_clocked_out", False)
        self.clock_in_time_text = data.get("clock_in_text", "")
        self.clock_out_time_text = data.get("clock_out_text", "")
        self.clock_in_raw = data.get("clock_in_raw")
        self.clock_out_raw = data.get("clock_out_raw")
        self.employee_name = data.get("employee", "Mr. Rahul Jangir")

        # Parse clock-in datetime for live ticking timer
        if self.clock_in_raw and self.clock_in_raw != "00:00:00":
            try:
                today_str = datetime.now().strftime("%Y-%m-%d")
                self.clock_in_dt = datetime.strptime(f"{today_str} {self.clock_in_raw}", "%Y-%m-%d %H:%M:%S")
            except Exception:
                self.clock_in_dt = None
        else:
            self.clock_in_dt = None

        # Update Icon
        if self.is_clocked_in and not self.is_clocked_out:
            if os.path.exists(ICON_CLOCKIN):
                self.indicator.set_icon_full(ICON_CLOCKIN, "Clocked In")
            self.item_header.set_label(f"● Clocked In ({self.clock_in_time_text})")
            self.item_clock_in.set_label(f"✓ Already Clocked In ({self.clock_in_time_text})")
            self.item_clock_in.set_sensitive(False)
            self.item_clock_out.set_sensitive(True)
        elif self.is_clocked_out:
            if os.path.exists(ICON_CLOCKOUT):
                self.indicator.set_icon_full(ICON_CLOCKOUT, "Clocked Out")
            self.item_header.set_label(f"● Clocked Out ({self.clock_out_time_text})")
            self.item_clock_in.set_label("Clocked Out for Today")
            self.item_clock_in.set_sensitive(False)
            self.item_clock_out.set_label(f"✓ Clocked Out at {self.clock_out_time_text}")
            self.item_clock_out.set_sensitive(False)
        else:
            if os.path.exists(ICON_CLOCKOUT):
                self.indicator.set_icon_full(ICON_CLOCKOUT, "Not Clocked In")
            self.item_header.set_label("○ Not Clocked In Today")
            self.item_clock_in.set_label("▶ Clock In Now")
            self.item_clock_in.set_sensitive(True)
            self.item_clock_out.set_sensitive(False)

        self.tick_live_timer()

    def tick_live_timer(self):
        if self.is_clocked_in and self.clock_in_dt and not self.is_clocked_out:
            elapsed = datetime.now() - self.clock_in_dt
            secs = max(0, int(elapsed.total_seconds()))
            h = secs // 3600
            m = (secs % 3600) // 60
            s = secs % 60
            timer_str = f"{h:02d}:{m:02d}:{s:02d}"
            self.item_timer.set_label(f"⏱ Worked Today: {timer_str}")
        elif self.is_clocked_out:
            self.item_timer.set_label("⏱ Completed for Today")
        else:
            self.item_timer.set_label("⏱ Worked Today: 00:00:00")
        return True

    def on_clock_in_clicked(self, widget):
        self.item_header.set_label("● Clocking in...")

        def worker():
            try:
                data = self.fetch_dashboard()
                if data["is_clocked_in"]:
                    GLib.idle_add(self.apply_status_update, data)
                    self.notify("OneOrganize HRM", f"Already Clocked In at {data['clock_in_text']}")
                    return

                action_url = f"{DEFAULT_BASE_URL}/attendanceemployee/attendance"
                post_data = urllib.parse.urlencode({
                    "_token": data["cin_form_token"],
                    "in": "0"
                }).encode('utf-8')

                self.request(
                    action_url, data=post_data, method="POST",
                    headers={"Referer": f"{DEFAULT_BASE_URL}/account-dashboard", "X-Requested-With": "XMLHttpRequest"}
                )
                self.save_cookies()
                new_data = self.fetch_dashboard()
                GLib.idle_add(self.apply_status_update, new_data)
                self.notify("OneOrganize HRM", f"Clock In Successful at {new_data['clock_in_text']}")
            except Exception as e:
                self.notify("OneOrganize Error", str(e), icon="dialog-error", urgency="critical")

        threading.Thread(target=worker, daemon=True).start()

    def on_clock_out_clicked(self, widget):
        # Open Task Dialog (pre-selected SDV Platform)
        dialog = Gtk.Dialog(
            title="Today's Task - SDV Platform",
            flags=Gtk.DialogFlags.MODAL | Gtk.DialogFlags.DESTROY_WITH_PARENT
        )
        dialog.set_default_size(440, 320)
        dialog.set_border_width(12)

        # Style with dark theme
        css = b"""
        dialog, window {
            background-color: #2E3440;
            color: #ECEFF4;
        }
        textview, textview text {
            background-color: #3B4252;
            color: #ECEFF4;
            border-radius: 6px;
            font-size: 13px;
            padding: 8px;
        }
        button.suggested-action {
            background-color: #BF616A;
            color: white;
            font-weight: bold;
            border-radius: 6px;
        }
        """
        style_provider = Gtk.CssProvider()
        style_provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            dialog.get_screen(), style_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        content_area = dialog.get_content_area()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        content_area.add(box)

        # Project Label
        lbl_proj = Gtk.Label(label="<b>Project:</b> SDV Platform (ID: 2)", use_markup=True)
        lbl_proj.set_xalign(0)
        box.pack_start(lbl_proj, False, False, 0)

        # Instruction
        lbl_inst = Gtk.Label(label="Enter your daily task description (minimum 50 characters):")
        lbl_inst.set_xalign(0)
        box.pack_start(lbl_inst, False, False, 0)

        # Text View for Task
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(120)
        text_view = Gtk.TextView()
        text_view.set_wrap_mode(Gtk.WrapMode.WORD)
        buffer = text_view.get_buffer()
        buffer.set_text(DEFAULT_TASK)
        scroll.add(text_view)
        box.pack_start(scroll, True, True, 0)

        # Character Counter Label
        lbl_count = Gtk.Label(label=f"{len(DEFAULT_TASK)} / 50 min characters")
        lbl_count.set_xalign(0)
        box.pack_start(lbl_count, False, False, 0)

        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        btn_submit = dialog.add_button("Submit & Clock Out", Gtk.ResponseType.OK)
        btn_submit.get_style_context().add_class("suggested-action")

        def on_text_changed(buf):
            start = buf.get_start_iter()
            end = buf.get_end_iter()
            length = len(buf.get_text(start, end, True).strip())
            if length >= 50:
                lbl_count.set_markup(f"<span color='#A3BE8C'>{length} / 50 min characters ✓</span>")
                btn_submit.set_sensitive(True)
            else:
                lbl_count.set_markup(f"<span color='#EBCB8B'>{length} / 50 min characters (Need {50 - length} more)</span>")
                btn_submit.set_sensitive(False)

        buffer.connect("changed", on_text_changed)

        box.show_all()
        response = dialog.run()

        if response == Gtk.ResponseType.OK:
            start = buffer.get_start_iter()
            end = buffer.get_end_iter()
            task_text = buffer.get_text(start, end, True).strip()
            dialog.destroy()
            self.perform_clock_out(task_text)
        else:
            dialog.destroy()

    def perform_clock_out(self, task_text):
        self.item_header.set_label("● Clocking out...")

        def worker():
            try:
                data = self.fetch_dashboard()
                if not data["is_clocked_in"]:
                    self.notify("OneOrganize Error", "You are not clocked in today.", icon="dialog-error", urgency="critical")
                    return
                if data["is_clocked_out"]:
                    GLib.idle_add(self.apply_status_update, data)
                    self.notify("OneOrganize HRM", f"Already Clocked Out at {data['clock_out_text']}")
                    return

                task = task_text.strip()
                if len(task) < 50:
                    task = (task + f" (SDV Platform: {DEFAULT_TASK})")[:150]

                post_data = urllib.parse.urlencode([
                    ("_token", data["cout_token"]),
                    ("project_id[]", DEFAULT_PROJECT_ID),
                    ("task", task),
                    ("out", "1")
                ]).encode('utf-8')

                self.request(
                    data["cout_action"], data=post_data, method="POST",
                    headers={"Referer": f"{DEFAULT_BASE_URL}/account-dashboard", "X-Requested-With": "XMLHttpRequest"}
                )
                self.save_cookies()
                new_data = self.fetch_dashboard()
                GLib.idle_add(self.apply_status_update, new_data)
                self.notify("OneOrganize HRM", f"Clock Out Successful at {new_data['clock_out_text']}")
            except Exception as e:
                self.notify("OneOrganize Error", str(e), icon="dialog-error", urgency="critical")

        threading.Thread(target=worker, daemon=True).start()

    def on_open_portal_clicked(self, widget):
        url = f"{DEFAULT_BASE_URL}/account-dashboard"
        subprocess.Popen(["google-chrome", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    app = OneOrganizeTray()
    Gtk.main()


if __name__ == "__main__":
    main()
